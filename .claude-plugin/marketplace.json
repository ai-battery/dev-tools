{
  "plugins": [
    {
      "id": "react-development",
      "name": "React Development",
      "description": "A comprehensive Claude plugin for enhancing React development with automated code quality tools and 57 best practice guidelines.",
      "version": "0.0.1",
      "author": "Hans Eilers",
      "path": "./react-development",
      "features": [
        "Auto-linting with ESLint",
