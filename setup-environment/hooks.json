{
  "hooks": {
    "Setup": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/setup.py",
        "description": "Initialize environment, check dependencies, gather project context"
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py --load-context",
        "description": "Load development context (git status, TODO files, recent issues) at session start"
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session_end.py --cleanup",
        "description": "Log session end and clean up temporary files"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt_submit.py --store-last-prompt",
        "description": "Log user prompts and manage session data"
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py",
        "description": "Block dangerous rm -rf commands and .env file access"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py",
        "description": "Log all tool usage for auditing"
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use_failure.py",
        "description": "Log tool failures with error details"
      }
    ],
    "PermissionRequest": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/permission_request.py",
        "description": "Log permission requests for auditing"
      }
    ],
    "Notification": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/notification.py",
        "description": "Log notifications when agent needs user input"
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre_compact.py --backup",
        "description": "Backup transcript before context compaction"
      }
    ],
    "SubAgentStart": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent_start.py",
        "description": "Log subagent spawn events"
      }
    ],
    "SubAgentStop": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent_stop.py",
        "description": "Log subagent completion events"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop.py",
        "description": "Log session stop events"
      }
    ]
  }
}
