{
  "hooks": {
    "OnPluginInstall": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh",
        "description": "Install and verify required dependencies (prettier, typescript, typescript-language-server, eslint)"
      }
    ],
    "OnPluginUninstall": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/scripts/uninstall.sh",
        "description": "Remove global npm packages and configuration files"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/lint-typescript.sh",
            "args": ["${CLAUDE_TOOL_OUTPUT_FILE}"],
            "description": "Lint TypeScript/JavaScript files using ESLint"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/format-typescript.sh",
            "args": ["${CLAUDE_TOOL_OUTPUT_FILE}"],
            "description": "Auto-format TypeScript/JavaScript files using Prettier"
          }
        ]
      }
    ]
  }
}
