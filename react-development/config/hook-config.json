{
  "version": "1.0.0",
  "name": "React Development Quality Check",
  "description": "Quality checks optimized for React/TypeScript projects",
  "projectType": "react",
  "typescript": {
    "enabled": true,
    "showDependencyErrors": false,
    "jsx": "react-jsx"
  },
  "eslint": {
    "enabled": true,
    "autofix": true
  },
  "prettier": {
    "enabled": true,
    "autofix": true
  },
  "general": {
    "autofixSilent": true,
    "debug": false
  },
  "rules": {
    "console": {
      "enabled": true,
      "severity": "info",
      "message": "Consider using a logging library for production",
      "allowIn": {
        "paths": ["src/utils/", "src/lib/"],
        "fileTypes": ["test", "component"],
        "patterns": ["*.dev.ts", "*.dev.tsx", "*.test.*"]
      }
    },
    "asAny": {
      "enabled": true,
      "severity": "warning",
      "message": "Prefer proper types or 'as unknown' for type assertions"
    },
    "debugger": {
      "enabled": true,
      "severity": "error",
      "message": "Remove debugger statements before committing"
    },
    "todos": {
      "enabled": true,
      "severity": "info",
      "patterns": ["TODO", "FIXME", "HACK"]
    }
  },
  "fileTypes": {
    "component": {
      "patterns": ["*.tsx", "*.jsx"],
      "paths": ["src/components/", "src/pages/", "src/views/", "app/"]
    },
    "hook": {
      "patterns": ["use*.ts", "use*.tsx"],
      "paths": ["src/hooks/"]
    },
    "redux": {
      "patterns": ["*Slice.ts", "*Reducer.ts"],
      "paths": ["src/store/", "src/slices/", "src/reducers/"]
    },
    "test": {
      "patterns": ["*.test.*", "*.spec.*"],
      "paths": ["__tests__/", "test/", "tests/"]
    }
  },
  "ignore": {
    "paths": [
      "node_modules/",
      "build/",
      "dist/",
      ".next/",
      "coverage/",
      "public/",
      "*.config.js",
      "*.config.ts",
      "*.config.mjs",
      "vite.config.*",
      "vitest.config.*"
    ]
  }
}
